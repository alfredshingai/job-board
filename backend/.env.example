# --- Database -------------------------------------------------------------
# Local Postgres (Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobboard?schema=public"
# Neon (recommended free host): copy the *pooled* connection string and append &sslmode=require

# --- Auth -----------------------------------------------------------------
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---------------------------------------------------------------
PORT=4000
# Comma-separated list of allowed origins (frontend URL(s))
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
